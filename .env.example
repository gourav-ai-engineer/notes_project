# Server-side only. Never prefix with VITE_ — that would expose it to the browser.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# Tried when the main model keeps failing from overload or quota. Use `none` to disable.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_MS=45000
# API_PORT=8787
# Generate calls per client IP per minute. Default: 10 in production, off in development. 0 disables.
# RATE_LIMIT_PER_MIN=10
